[Unit]
Description=Experiment Doctor HTTPS and static frontend
After=network-online.target experiment-doctor-api.service
Wants=network-online.target

[Service]
User=doctor-web
Group=doctor-web
EnvironmentFile=/etc/experiment-doctor/web.env
ExecStart=/usr/bin/caddy run --config /opt/experiment-doctor/current/infra/caddy/Caddyfile --adapter caddyfile
ExecReload=/usr/bin/caddy reload --config /opt/experiment-doctor/current/infra/caddy/Caddyfile --adapter caddyfile
Environment=HOME=/var/lib/experiment-doctor/web
StateDirectory=experiment-doctor/web
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
