# Copy privately to .env; never commit credentials.
INFERENCE_BASE_URL=https://api.vultrinference.com/v1
INFERENCE_MODEL=
INFERENCE_API_KEY=
# Pre-pulled immutable reference; never a mutable tag.
SIMULATION_IMAGE=
# Locally built trusted verifier image ID, or a published repository@sha256 digest.
VERIFIER_IMAGE=
# Deployment splits these into role-scoped files over verified SSH.
# Blank session key preserves the remote key, or generates it on first deployment.
API_SESSION_KEY=
API_OPERATOR_TOKEN=
API_ENABLE_OPERATOR_PROBES=0
PUBLIC_ORIGIN=https://doctor.example
# Optional instead of PUBLIC_ORIGIN; if both are set, they must identify the same host.
PUBLIC_HOST=
ACME_EMAIL=
